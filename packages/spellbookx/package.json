{
  "name": "spellbookx",
  "version": "1.1.2",
  "private": false,
  "description": "🧙 Wizard CLI for the Spellbookx developer toolchain (ESLint, Prettier, CSpell, Commitlint).",
  "keywords": [
    "cli",
    "spellbookx",
    "sbx",
    "wizard",
    "eslint",
    "prettier",
    "cspell",
    "commitlint",
    "toolchain"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git",
    "directory": "packages/spellbookx"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sbx": "./dist/cli.js",
    "spellbookx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c && tsc",
    "release": "pnpm publish --access public --no-git-checks",
    "test": "vitest run --no-fsModuleCache"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "execa": "^9.5.2",
    "figlet": "^1.12.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@dcdavidev/tsconfig": "^0.1.0",
    "@types/node": "^25.3.0",
    "rolldown": "1.0.0-rc.5",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
