{
  "name": "spellbookx",
  "version": "1.3.0",
  "private": false,
  "description": "🧙 Wizard CLI for the Spellbookx developer toolchain (ESLint, Prettier, CSpell, Commitlint, czg, Lefthook).",
  "keywords": [
    "cli",
    "spellbookx",
    "sbx",
    "wizard",
    "eslint",
    "prettier",
    "cspell",
    "commitlint",
    "czg",
    "lefthook",
    "toolchain"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git",
    "directory": "packages/spellbookx"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sbx": "./dist/cli.js",
    "spellbookx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "lint:types": "tsc",
    "test": "vitest run --no-fsModuleCache"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "figlet": "^1.13.0",
    "ora": "^10.0.0"
  },
  "devDependencies": {
    "@dcdavidev/tsconfig": "^0.1.0",
    "@types/node": "^25.9.9",
    "rolldown": "1.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
