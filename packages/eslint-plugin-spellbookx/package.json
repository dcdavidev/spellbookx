{
  "name": "eslint-plugin-spellbookx",
  "version": "1.2.0",
  "private": false,
  "description": "A comprehensive ESLint plugin with shareable configs for JS/TS, React, JSON, and more.",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-plugin",
    "lint",
    "prettier",
    "spellbookx",
    "typescript"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git",
    "directory": "packages/eslint-plugin-spellbookx"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./all": {
      "types": "./dist/configs/all.d.ts",
      "import": "./dist/configs/all.js",
      "default": "./dist/configs/all.js"
    },
    "./astro": {
      "types": "./dist/configs/astro.d.ts",
      "import": "./dist/configs/astro.js",
      "default": "./dist/configs/astro.js"
    },
    "./base": {
      "types": "./dist/configs/base.d.ts",
      "import": "./dist/configs/base.js",
      "default": "./dist/configs/base.js"
    },
    "./cspell": {
      "types": "./dist/configs/cspell.d.ts",
      "import": "./dist/configs/cspell.js",
      "default": "./dist/configs/cspell.js"
    },
    "./ignores": {
      "types": "./dist/configs/ignores.d.ts",
      "import": "./dist/configs/ignores.js",
      "default": "./dist/configs/ignores.js"
    },
    "./javascript": {
      "types": "./dist/configs/javascript.d.ts",
      "import": "./dist/configs/javascript.js",
      "default": "./dist/configs/javascript.js"
    },
    "./json": {
      "types": "./dist/configs/json.d.ts",
      "import": "./dist/configs/json.js",
      "default": "./dist/configs/json.js"
    },
    "./markdown": {
      "types": "./dist/configs/markdown.d.ts",
      "import": "./dist/configs/markdown.js",
      "default": "./dist/configs/markdown.js"
    },
    "./node": {
      "types": "./dist/configs/node.d.ts",
      "import": "./dist/configs/node.js",
      "default": "./dist/configs/node.js"
    },
    "./prettier": {
      "types": "./dist/configs/prettier.d.ts",
      "import": "./dist/configs/prettier.js",
      "default": "./dist/configs/prettier.js"
    },
    "./react": {
      "types": "./dist/configs/react.d.ts",
      "import": "./dist/configs/react.js",
      "default": "./dist/configs/react.js"
    },
    "./recommended": {
      "types": "./dist/configs/recommended.d.ts",
      "import": "./dist/configs/recommended.js",
      "default": "./dist/configs/recommended.js"
    },
    "./recommended-spellcheck": {
      "types": "./dist/configs/recommended-spellcheck.d.ts",
      "import": "./dist/configs/recommended-spellcheck.js",
      "default": "./dist/configs/recommended-spellcheck.js"
    },
    "./strict": {
      "types": "./dist/configs/strict.d.ts",
      "import": "./dist/configs/strict.js",
      "default": "./dist/configs/strict.js"
    },
    "./svelte": {
      "types": "./dist/configs/svelte.d.ts",
      "import": "./dist/configs/svelte.js",
      "default": "./dist/configs/svelte.js"
    },
    "./vuoto": {
      "types": "./dist/configs/vuoto.d.ts",
      "import": "./dist/configs/vuoto.js",
      "default": "./dist/configs/vuoto.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rolldown -c && tsc",
    "release": "pnpm publish --access public --no-git-checks",
    "test": "vitest run --no-fsModuleCache"
  },
  "dependencies": {
    "@cspell/eslint-plugin": "^10.4.0",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@spellbookx/recipes": "workspace:*",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node-dependencies": "^2.3.0",
    "eslint-plugin-package-json": "^1.10.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-vuoto": "^1.0.0",
    "globals": "^17.13.0",
    "jsonc-eslint-parser": "^3.3.0",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@dcdavidev/tsconfig": "^0.1.0",
    "@types/node": "^25.3.0",
    "eslint": "^10.13.0",
    "rolldown": "1.0.0-rc.5",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "eslint": "^9.39.2 || ^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
