{
  "name": "commitlint-config-spellbookx",
  "version": "1.2.0",
  "private": false,
  "description": "A shareable Commitlint configuration for enforcing conventional commits.",
  "keywords": [
    "commit-config",
    "commitizen",
    "commitlint",
    "commitlint-config",
    "conventional-commits",
    "cz-git",
    "spellbookx"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git",
    "directory": "packages/commitlint-config-spellbookx"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js",
      "default": "./dist/rules.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "import": "./dist/prompt.js",
      "default": "./dist/prompt.js"
    },
    "./scopes": {
      "types": "./dist/scopes.d.ts",
      "import": "./dist/scopes.js",
      "default": "./dist/scopes.js"
    },
    "./constants": {
      "types": "./dist/constants/commit-types.d.ts",
      "import": "./dist/constants/commit-types.js",
      "default": "./dist/constants/commit-types.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rolldown -c && tsc",
    "release": "pnpm publish --access public --no-git-checks",
    "test": "vitest run --no-fsModuleCache"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cz-git": "^1.14.0",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@dcdavidev/tsconfig": "^0.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.0",
    "rolldown": "1.0.0-rc.5",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
