{
  "name": "cz-config-spellbookx",
  "version": "2.1.3",
  "private": false,
  "description": "A shareable czg configuration for interactive Conventional Commits.",
  "keywords": [
    "commit-config",
    "conventional-commits",
    "cz-config",
    "czg",
    "spellbookx"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git",
    "directory": "packages/cz-config-spellbookx"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <info@dcdavidev.me>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "import": "./dist/prompt.js",
      "default": "./dist/prompt.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .turbo",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint:types": "tsc -p tsconfig.json",
    "test": "vitest run --no-fsModuleCache --passWithNoTests --coverage"
  },
  "dependencies": {
    "@spellbookx/recipes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "czg": "^1.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "czg": "^1.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
