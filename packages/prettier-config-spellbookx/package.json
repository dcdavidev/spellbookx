    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-embed": "^0.8.1",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-multiline-arrays": "^4.1.11",
