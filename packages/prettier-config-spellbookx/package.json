    "astro",
    "config",
    "formatting",
    "prettier",
    "prettier-config",
    "prettier-plugin",
    "prisma",
    "spellbookx",
    "tailwind"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
