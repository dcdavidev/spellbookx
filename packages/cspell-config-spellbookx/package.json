{
  "name": "cspell-config-spellbookx",
  "version": "2.0.0",
  "private": false,
  "description": "A shareable CSpell configuration for spell-checking in a monorepo.",
  "keywords": [
    "cspell",
    "cspell-config",
    "spellbookx",
    "spellcheck",
    "spellchecker"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git",
    "directory": "packages/cspell-config-spellbookx"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <info@dcdavidev.me>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "default": "./dist/constants/index.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js",
      "default": "./dist/constants/*.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .turbo",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint:types": "tsc -p tsconfig.json",
    "test": "vitest run --no-fsModuleCache --passWithNoTests --coverage"
  },
  "dependencies": {
    "@cspell/cspell-types": "^10.5.2",
    "@spellbookx/recipes": "workspace:*",
    "cspell": "^10.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
