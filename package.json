{
  "name": "spellbookx-workspace",
  "private": true,
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git"
  },
  "author": {
    "name": "Davide Di Criscito"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:commits": "changeset-conventional",
    "changeset:version": "changeset version",
    "clean": "rm -rf .turbo packages/*/.turbo packages/*/dist",
    "commit": "pnpm exec czg --config=./.config/cz.mjs",
    "cz": "pnpm commit",
    "czg": "pnpm commit",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "pnpm run \"/^lint:(code|spelling|types)$/\"",
    "lint:code": "eslint --no-warn-ignored .",
    "lint:code:fix": "eslint --no-warn-ignored --fix .",
    "lint:commits": "commitlint --config ./.config/commitlint.mjs --from=HEAD~1 --verbose",
    "lint:spelling": "cspell --no-progress --no-summary .",
    "lint:types": "turbo run lint:types",
    "prepare": "lefthook install",
    "release": "dropdx",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "update:turbo": "pnpm dlx @turbo/codemod@latest update --force"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dcdavidev/dropdx": "^0.4.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26",
    "changeset-conventional-commits": "^1.0.4",
    "commitlint-config-spellbookx": "workspace:*",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.5.2",
    "cspell-config-spellbookx": "workspace:*",
    "cz-config-spellbookx": "workspace:*",
    "czg": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-spellbookx": "workspace:*",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-config-spellbookx": "workspace:*",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-properties": "^0.4.0",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-toml": "^4.1.0",
    "rolldown": "^1.3.3",
    "turbo": "^2.11.13",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  }
}
