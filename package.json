{
  "name": "spellbookx-workspace",
  "private": true,
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <info@dcdavidev.me>",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:commits": "changeset-conventional",
    "changeset:version": "changeset version",
    "check": "tsc --noEmit && turbo run build lint:code lint:spelling lint:types fmt:check test",
    "clean": "turbo run clean",
    "commit": "czg",
    "dev": "turbo run dev",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "turbo run lint:code lint:spelling",
    "lint:code": "eslint --no-warn-ignored .",
    "lint:code:fix": "eslint --no-warn-ignored --fix .",
    "lint:commits": "commitlint --from=HEAD~1 --verbose",
    "lint:spelling": "cspell --no-progress --no-summary .",
    "lint:types": "tsc --noEmit && turbo run lint:types",
    "prepare": "lefthook install",
    "release": "dropdx",
    "test": "turbo run test",
    "update:node": "pnpm exec tsx ./scripts/update-node.ts",
    "update:turbo": "pnpm exec tsx ./scripts/update-turbo.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dcdavidev/dropdx": "^0.4.0",
    "@spellbookx/recipes": "workspace:*",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "changeset-conventional-commits": "^1.0.4",
    "commitlint-config-spellbookx": "workspace:*",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.5.2",
    "cspell-config-spellbookx": "workspace:*",
    "cz-config-spellbookx": "workspace:*",
    "czg": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-spellbookx": "workspace:*",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-config-spellbookx": "workspace:*",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.23.0",
      "onFail": "download"
    }
  }
}
