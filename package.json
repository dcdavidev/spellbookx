{
  "name": "spellbookx-workspace",
  "private": true,
  "homepage": "https://github.com/dcdavidev/spellbookx#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx.git"
  },
  "author": {
    "name": "Davide Di Criscito"
  },
  "scripts": {
    "build": "turbo run build",
    "build:force": "turbo run build --force",
    "changeset": "changeset",
    "changeset:conventional": "changeset-conventional",
    "check": "pnpm run lint && pnpm run spellcheck && pnpm run test",
    "check:ci": "pnpm run lint:check && pnpm run fmt:check && pnpm run spellcheck && pnpm run test:force",
    "clean": "rm -rf .turbo packages/*/.turbo packages/*/dist",
    "commit": "czg",
    "commit:lint": "commitlint --from=HEAD~1",
    "fmt": "pnpm exec prettier --ignore-unknown --write .",
    "fmt:check": "pnpm exec prettier --ignore-unknown --check .",
    "lint": "pnpm exec eslint --no-warn-ignored --fix .",
    "lint:check": "pnpm exec eslint --no-warn-ignored .",
    "lint:fmt": "pnpm run lint && pnpm run fmt",
    "prepare": "lefthook install",
    "publish": "pnpm run version && pnpm run release",
    "release": "turbo run release",
    "release:auto": "dropdx",
    "spellcheck": "pnpm exec cspell --no-progress --no-summary .",
    "spellcheck:all": "pnpm exec cspell .",
    "test": "turbo run test",
    "test:force": "turbo run test --force",
    "test:unit": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "turbo:update": "pnpm dlx @turbo/codemod@latest update --force",
    "version": "changeset version"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@cspell/cspell-types": "^10.4.0",
    "@dcdavidev/dropdx": "^0.2.0",
    "@dcdavidev/tsconfig": "^0.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@spellbookx/recipes": "workspace:*",
    "@turbo/gen": "^2.11.10",
    "@types/node": "^25.3.0",
    "changeset-conventional-commits": "^1.0.4",
    "commitizen": "^4.3.2",
    "commitlint-config-spellbookx": "workspace:*",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.4.0",
    "cspell-config-spellbookx": "workspace:*",
    "cz-config-spellbookx": "workspace:*",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-spellbookx": "workspace:*",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-config-spellbookx": "workspace:*",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-toml": "^4.1.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  }
}
